{
  "name": "elite-dev-verzel",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @elite/api\" \"npm run dev -w @elite/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @elite/api",
    "lint": "eslint .",
    "db:migrate": "npm run db:migrate -w @elite/api",
    "db:seed": "npm run db:seed -w @elite/api"
  },
  "overrides": {"@vercel/cli-config":{"zod":"^4.6.7"}},
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@neon/config": "^1.9.4",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
