{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "node scripts/check-web-env.mjs && npm run build -w @elite/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{"source":"/((?!assets/).*)","destination":"/index.html"}],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"}
    ]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
