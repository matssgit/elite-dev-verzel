DATABASE_URL=postgres://elite:elite_local@localhost:54329/elite
PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional separate database for integration tests; tests create unique users and do not truncate data.
TEST_DATABASE_URL=postgres://elite:elite_local@localhost:54329/elite
# Vite defaults to /api through the local proxy. In production set the public API URL.
VITE_API_URL=/api
# Independent checkpoints and signing key; persist/back up this directory outside PostgreSQL.
AUDIT_DIRECTORY=./var/audit
# Production: PKCS8 Ed25519 AUDIT_PRIVATE_KEY, or persistent-file mode on a verified mount.
# Never put the private key in PostgreSQL or in VITE_* variables.
# Paid Render proposal is archived in deploy/render.paid.yaml; not authorized to apply.
# Keep the following disabled on local Windows:
# AUDIT_KEY_MODE=persistent-file
# AUDIT_REQUIRE_MOUNT=true
# AUDIT_MOUNT_PATH=/var/data
# Free demo production only (configure secrets in provider settings, not in Git):
# AUDIT_STORAGE=blob
# AUDIT_BLOB_PREFIX=elite-v1/
# BLOB_READ_WRITE_TOKEN=<protected-provider-secret>
# AUDIT_PRIVATE_KEY=<protected-ed25519-pkcs8-secret>
# AUDIT_PUBLIC_KEY_FINGERPRINT=<trusted-public-fingerprint>
# RUN_SETTLEMENT_JOBS=false
# FINANCIAL_MAINTENANCE=false
